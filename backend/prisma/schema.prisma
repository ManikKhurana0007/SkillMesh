generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

enum StudentBuildTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

model TeamInvitation {
  id          String           @id @default(cuid())
  teamId      String
  senderId    String
  recipientId String
  message     String?
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender User @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("InvitationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  @@unique([teamId, recipientId])
}

enum TeamStatus {
  FORMING
  SUBMITTED
  APPROVED
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum FormationRunStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum DisruptionType {
  MEMBER_UNAVAILABLE
  BLOCKED_TASK
  OVERDUE_TASK
  MILESTONE_AT_RISK
  OWNER_REPLACEMENT
  CAPACITY_SHORTFALL
  SCOPE_REDUCTION
}

enum RecoveryPlanStatus {
  PROPOSED
  APPROVED
  REJECTED
  APPLIED
  SUPERSEDED
}

datasource db {
  provider = "postgresql"
}

model Team {
  id          String     @id @default(cuid())
  challengeId String
  name        String
  description String?
  leaderId    String
  status      TeamStatus @default(FORMING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  leader User @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members TeamMember[]
  invitations TeamInvitation[]
  chatMessages TeamChatMessage[]
  project Project?
  studentBuildProjects StudentBuildProject[]
  @@unique([challengeId, name])
  @@unique([challengeId, leaderId])
  @@index([challengeId, status])
}

model TeamMember {
  id          String   @id @default(cuid())
  teamId      String
  challengeId String
  userId      String
  role        String?
  weeklyCapacity Int?
  joinedAt    DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([challengeId, userId])
  @@unique([teamId, userId])
  @@index([teamId])
}

model TeamChatMessage {
  id        String   @id @default(cuid())
  teamId    String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments TeamChatAttachment[]

  @@index([teamId, createdAt])
}

model TeamChatAttachment {
  id           String   @id @default(cuid())
  messageId    String
  fileName     String
  mimeType     String
  size         Int
  storageName  String   @unique
  createdAt    DateTime @default(now())

  message TeamChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ParticipantConstraint {
  id             String   @id @default(cuid())
  challengeId    String
  userId         String
  weeklyCapacity Int      @default(0)
  available      Boolean  @default(true)
  notes          String?
  updatedAt      DateTime @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership ChallengeMember? @relation(fields: [challengeId, userId], references: [challengeId, userId])
  @@unique([challengeId, userId])
}

model FormationRun {
  id          String             @id @default(cuid())
  challengeId String
  createdById String
  algorithm   String
  config      Json
  status      FormationRunStatus @default(DRAFT)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  createdBy User @relation("FormationRunCreator", fields: [createdById], references: [id])
  alternatives FormationAlternative[]
  audits FormationAudit[]
  @@index([challengeId, createdAt])
}

model FormationAlternative {
  id          String   @id @default(cuid())
  runId       String
  rank        Int
  score       Float
  feasible    Boolean
  memberIds   Json
  evaluation  Json
  createdAt   DateTime @default(now())

  run FormationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@unique([runId, rank])
}

model FormationAudit {
  id          String   @id @default(cuid())
  runId       String
  actorId     String
  action      String
  reason      String?
  snapshot    Json
  createdAt   DateTime @default(now())

  run FormationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])
  @@index([runId, createdAt])
}

model Project {
  id          String        @id @default(cuid())
  teamId      String        @unique
  createdById String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation("ProjectCreator", fields: [createdById], references: [id])
  tasks Task[]
  milestones Milestone[]
  disruptions DisruptionScenario[]
}

model Task {
  id              String     @id @default(cuid())
  projectId       String
  ownerId         String?
  title           String
  description     String?
  status          TaskStatus @default(TODO)
  estimateHours   Int        @default(0)
  completedHours  Int        @default(0)
  dueAt           DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner User? @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  dependencies TaskDependency[] @relation("TaskDependencies")
  dependents TaskDependency[] @relation("TaskDependents")
  recoveryChanges RecoveryTaskChange[]
  @@index([projectId, status])
}

model TaskDependency {
  id            String @id @default(cuid())
  predecessorId String
  successorId   String

  predecessor Task @relation("TaskDependents", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor Task @relation("TaskDependencies", fields: [successorId], references: [id], onDelete: Cascade)
  @@unique([predecessorId, successorId])
}

model Milestone {
  id        String   @id @default(cuid())
  projectId String
  title     String
  dueAt     DateTime
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model StudentBuildProject {
  id                 String   @id @default(cuid())
  ownerId            String
  teamId             String?
  name               String
  description        String   @db.Text
  status             String   @default("ACTIVE")
  roadmap            Json?
  architecture       Json?
  techStack          String[] @default([])
  githubUrl          String?
  repositoryAnalysis Json?
  qualityScore       Int?
  showcaseUrl        String?
  showcasedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner User                  @relation("StudentBuildProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  team  Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  tasks StudentBuildTask[]

  @@index([ownerId, createdAt])
  @@index([teamId, updatedAt])
  @@index([showcasedAt, updatedAt])
}

model StudentBuildTask {
  id           String                 @id @default(cuid())
  projectId    String
  assigneeId   String?
  milestone    String
  title        String
  description  String                 @db.Text
  status       StudentBuildTaskStatus @default(TODO)
  estimateHours Int                   @default(1)
  dueAt        DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  project  StudentBuildProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?               @relation("StudentBuildTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([assigneeId, status])
}

model DisruptionScenario {
  id        String         @id @default(cuid())
  projectId String
  createdById String
  type      DisruptionType
  taskId    String?
  memberId  String?
  details   Json
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User @relation("DisruptionCreator", fields: [createdById], references: [id])
  plans RecoveryPlan[]
}

model RecoveryPlan {
  id          String             @id @default(cuid())
  scenarioId  String
  reviewedById String?
  algorithm   String
  rank        Int
  feasible    Boolean
  status      RecoveryPlanStatus @default(PROPOSED)
  summary     Json
  reason      String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  scenario DisruptionScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("RecoveryReviewer", fields: [reviewedById], references: [id])
  changes RecoveryTaskChange[]
  @@unique([scenarioId, rank])
}

model RecoveryTaskChange {
  id              String @id @default(cuid())
  planId          String
  taskId          String
  previousOwnerId String?
  proposedOwnerId String?
  previousStatus  TaskStatus?
  proposedStatus  TaskStatus?
  plan RecoveryPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

enum UserRole {
  STUDENT
  ORGANIZER
  MENTOR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STUDENT)
  profile StudentProfile?
  notifications Notification[]
organizedChallenges Challenge[] @relation("OrganizerChallenges")
challengeMemberships ChallengeMember[]
teamsLed Team[] @relation("TeamLeader")
teamMemberships TeamMember[]
sentTeamChatMessages TeamChatMessage[]
sentTeamInvitations TeamInvitation[] @relation("InvitationSender")
receivedTeamInvitations TeamInvitation[] @relation("InvitationRecipient")
createdFormationRuns FormationRun[] @relation("FormationRunCreator")
createdProjects Project[] @relation("ProjectCreator")
assignedTasks Task[] @relation("TaskOwner")
createdDisruptions DisruptionScenario[] @relation("DisruptionCreator")
reviewedRecoveryPlans RecoveryPlan[] @relation("RecoveryReviewer")
participantConstraints ParticipantConstraint[]
formationAudits FormationAudit[]
mentorshipSessions MentorshipSession[] @relation("MentorSessions")
sessionBookings SessionBooking[] @relation("StudentSessionBookings")
meetingNotes MeetingNote[] @relation("MeetingNoteAuthor")
mentorProjectOpportunities MentorProjectOpportunity[] @relation("MentorProjectOpportunities")
ideaSubmissions IdeaSubmission[] @relation("StudentIdeaSubmissions")
resumes Resume[]
resumeBuilderDraft ResumeBuilderDraft?
studentBuildProjects StudentBuildProject[] @relation("StudentBuildProjectOwner")
assignedBuildTasks StudentBuildTask[] @relation("StudentBuildTaskAssignee")
createdAt    DateTime @default(now())
updatedAt    DateTime @updatedAt
}

enum MentorSessionStatus {
  OPEN
  CANCELLED
  COMPLETED
}

enum SessionBookingStatus {
  BOOKED
  CANCELLED
}

enum MentorProjectStatus {
  OPEN
  CLOSED
}

enum IdeaSubmissionStatus {
  PENDING
  ACCEPTED
  NEEDS_REVISION
  DECLINED
}

model MentorshipSession {
  id          String              @id @default(cuid())
  mentorId    String
  title       String
  description String
  startsAt    DateTime
  duration    Int
  capacity    Int
  status      MentorSessionStatus @default(OPEN)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  mentor   User             @relation("MentorSessions", fields: [mentorId], references: [id], onDelete: Cascade)
  bookings SessionBooking[]
  meetingNotes MeetingNote[]

  @@index([mentorId, startsAt])
  @@index([status, startsAt])
}

model SessionBooking {
  id        String               @id @default(cuid())
  sessionId String
  studentId String
  status    SessionBookingStatus @default(BOOKED)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  session MentorshipSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User              @relation("StudentSessionBookings", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId, status])
}

enum MeetingNoteType {
  NOTE
  KEY_POINT
}

model MeetingNote {
  id        String          @id @default(cuid())
  sessionId String
  authorId  String
  type      MeetingNoteType @default(NOTE)
  content   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  session MentorshipSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author  User              @relation("MeetingNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model MentorProjectOpportunity {
  id          String           @id @default(cuid())
  mentorId    String
  title       String
  description String
  skills      String[]         @default([])
  status      MentorProjectStatus @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  mentor      User             @relation("MentorProjectOpportunities", fields: [mentorId], references: [id], onDelete: Cascade)
  submissions IdeaSubmission[]

  @@index([mentorId, status, createdAt])
}

model IdeaSubmission {
  id             String               @id @default(cuid())
  opportunityId  String
  studentId      String
  title          String
  summary        String
  projectUrl     String?
  status         IdeaSubmissionStatus @default(PENDING)
  mentorFeedback String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  opportunity MentorProjectOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  student     User                     @relation("StudentIdeaSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, studentId])
  @@index([opportunityId, status, createdAt])
}


enum ChallengeStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model StudentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  headline       String?
  bio            String?
  university     String?
  degree         String?
  graduationYear Int?
  githubUrl      String?
  careerGoal     String?
  interests      String[] @default([])
  preferredRoles String[] @default([])
  githubStats    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills UserSkill[]
  availability WeeklyAvailability[]
  evidence ProfileEvidence[]
  activities LearningActivity[]
  practiceTasks PracticeTask[]
  quizAttempts QuizAttempt[]
}

model WeeklyAvailability {
  id        String   @id @default(cuid())
  profileId String
  dayOfWeek Int
  slot      String
  createdAt DateTime @default(now())

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, dayOfWeek, slot])
  @@index([profileId])
}

model ProfileEvidence {
  id        String   @id @default(cuid())
  profileId String
  title     String
  url       String
  kind      String   @default("PROJECT")
  createdAt DateTime @default(now())

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

model Resume {
  id          String        @id @default(cuid())
  userId      String
  fileName    String
  mimeType    String
  size        Int
  storageName String        @unique
  analysis    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches ResumeMatch[]

  @@index([userId, createdAt])
}

model ResumeMatch {
  id             String   @id @default(cuid())
  resumeId       String
  jobTitle       String?
  jobDescription String   @db.Text
  score          Int
  results        Json
  createdAt      DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
}

model ResumeBuilderDraft {
  id        String   @id @default(cuid())
  userId    String   @unique
  template  String   @default("modern")
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningActivity {
  id        String   @id @default(cuid())
  profileId String
  category  String
  minutes   Int
  loggedAt  DateTime @default(now())

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, loggedAt])
}

model PracticeTask {
  id          String   @id @default(cuid())
  profileId   String
  skillName   String
  title       String
  objective   String
  duration    Int
  scheduledFor DateTime
  status      String   @default("SCHEDULED")
  generationSource String @default("LOCAL")
  quiz        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile      StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  notification Notification?
  attempts     QuizAttempt[]

  @@index([profileId, scheduledFor])
  @@index([profileId, status, scheduledFor])
}

model QuizAttempt {
  id           String   @id @default(cuid())
  profileId    String
  practiceTaskId String
  score        Int
  answers      Json
  feedback     Json
  submittedAt  DateTime @default(now())

  profile      StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  practiceTask PracticeTask @relation(fields: [practiceTaskId], references: [id], onDelete: Cascade)

  @@index([profileId, submittedAt])
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  practiceTaskId String?  @unique
  title          String
  body           String
  read           Boolean  @default(false)
  scheduledFor   DateTime?
  createdAt      DateTime @default(now())

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceTask PracticeTask? @relation(fields: [practiceTaskId], references: [id], onDelete: SetNull)

  @@index([userId, scheduledFor])
  @@index([userId, read])
}

model Skill {
  id        String      @id @default(cuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  users     UserSkill[]
  challenges ChallengeSkill[]
}

model UserSkill {
  id            String           @id @default(cuid())
  profileId     String
  skillId       String
  proficiency   SkillProficiency @default(BEGINNER)
  evidenceUrl   String?
  createdAt     DateTime         @default(now())

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
}

model Challenge {
  id          String          @id @default(cuid())
  title       String
  description String
  deadline    DateTime
  teamSize    Int
  status      ChallengeStatus @default(DRAFT)
  organizerId String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  organizer User             @relation("OrganizerChallenges", fields: [organizerId], references: [id], onDelete: Cascade)
  requiredSkills ChallengeSkill[]
  memberships ChallengeMember[]
  teamMembers TeamMember[]
  teams Team[]
  formationRuns FormationRun[]
  participantConstraints ParticipantConstraint[]
}

model ChallengeSkill {
  id          String @id @default(cuid())
  challengeId String
  skillId     String
  weight      Float  @default(1)

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([challengeId, skillId])
}

model ChallengeMember {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  joinedAt    DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  constraint ParticipantConstraint?

  @@unique([challengeId, userId])
}